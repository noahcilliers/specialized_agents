# Copy this file to .env.local if you need to change anything, then restart `npm run dev`.
# Everything is optional: with Ollama running locally the app works without any of it.

# Where Ollama is running (default http://127.0.0.1:11434). Same variable Ollama's CLI uses.
# OLLAMA_HOST=http://127.0.0.1:11434

# The settings below are specific to this app, so OLLAMA_* exports in your shell profile don't affect it.

# Default model for agents that don't pick one. If unset, the app picks an installed model with tool support.
# MODULAR_MODEL=qwen3:8b

# Context window to request, in tokens (default 16384, allowed 2048-262144).
# Ollama reserves memory for the whole window up front: for qwen3:8b,
# 8K ≈ 6.6 GB total, 16K ≈ 7.8 GB, 32K ≈ 9.9 GB.
# MODULAR_NUM_CTX=16384

# How long Ollama keeps the model loaded after the last message (default 15m)
# MODULAR_KEEP_ALIVE=15m

# Google OAuth client (Web application) for the Google Calendar plugin.
# Authorized redirect URI: http://localhost:3000/api/plugins/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the app's URL if not http://localhost:3000 (used for the OAuth redirect).
# APP_URL=http://localhost:3000
